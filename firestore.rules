rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /leagues/{id}   { allow read, write: if signedIn(); }
    match /chunks/{id}    { allow read, write: if signedIn(); }
    match /locks/{id}     { allow read, write: if signedIn(); }
    match /profiles/{uid} { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == uid; }
    match /msgs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.a == request.auth.uid && request.resource.data.t.size() <= 500;
    }
    match /data/users/{uid}/{doc} { allow read, write: if signedIn() && request.auth.uid == uid; }
  }
}
